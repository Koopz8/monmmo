<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PokeMmo.Client</RootNamespace>
    <AssemblyName>monmmo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
  </ItemGroup>

  <!--
    The client is allowed to read the player's cartridge; the server is not, and
    must never reference RomExtract.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\RomExtract\RomExtract.csproj" />
  </ItemGroup>

</Project>
