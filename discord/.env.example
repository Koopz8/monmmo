# Copy this file to `.env` and fill it in. Never commit `.env`.

# Developer Portal → your app → Bot → Reset Token → copy
DISCORD_TOKEN=

# Right-click your server icon → Copy Server ID (needs Developer Mode on)
GUILD_ID=

# Shown in the welcome message and used for the server's identity
PROJECT_NAME=Overworld

# Linked from #welcome and #commits
REPO_URL=https://github.com/ZealSM/monmmo
